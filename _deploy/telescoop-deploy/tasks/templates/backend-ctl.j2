#!/bin/bash
# Run a Django management command of {{ project_slug }} as {{ main_user }}: {{ project_slug }}-ctl <command> [args...]
set -euo pipefail

cd "{{ backend_path }}"
manage=(
    env
    PATH="{{ venv.path }}/bin:$PATH"
    VIRTUAL_ENV="{{ venv.path }}"
    DJANGO_SETTINGS_MODULE="{{ django_project_name }}.settings"
    CONFIG_PATH="{{ backend_settings_path }}"
    "{{ venv.path }}/bin/python" manage.py "$@"
)

if [ "$(id -u)" -eq 0 ]; then
    exec runuser -u "{{ main_user }}" -- "${manage[@]}"
elif [ "$(id -un)" = "{{ main_user }}" ]; then
    exec "${manage[@]}"
fi
echo "Error: run this script as root or {{ main_user }} (for instance with sudo)." >&2
exit 1
